// src/llvm/lapis.jrg — lapis ketiga backend LLVM: builtin pustaka yang ditulis dalam JRG.
// `ns::nama` yang tidak punya penurun asli dicari di sini sebagai `ns_nama`; kalimat gagalnya
// sama dengan builtin aslinya di interpreter.
package lapis

pub fn arr_count_if<T, B>(a: []T, f: fn(T) -> B) -> int {
    var n = 0
    for _, x in a { if f(x) { n += 1 } }
    return n
}

pub fn arr_count<T, B>(a: []T, f: fn(T) -> B) -> int { return arr_count_if(a, f) }

// Jarum boleh bertipe lain dari elemennya: `==` lintas golongan `false` (`None`), bulat lawan pecahan menurut nilai.
pub fn arr_index_of<T, U>(a: []T, nilai: U) -> Option<int> {
    for i, x in a { if x == nilai { return Some(i) } }
    return None
}

pub fn arr_find_idx<T, B>(a: []T, f: fn(T) -> B) -> Option<int> {
    for i, x in a { if f(x) { return Some(i) } }
    return None
}

pub fn arr_is_empty<T>(a: []T) -> bool { return len(a) == 0 }

pub fn arr_chunks<T>(a: []T, ukuran: int) -> [][]T {
    if ukuran < 0 { panik("arr::chunks: ukuran tidak boleh negatif, dapat " + str(ukuran)) }
    if ukuran == 0 { panik("arr::chunks: ukuran harus lebih dari 0") }
    var keluar: [][]T = []
    var kini: []T = []
    for _, x in a {
        kini += [x]
        if len(kini) == ukuran {
            keluar += [kini]
            kini = []
        }
    }
    if len(kini) > 0 { keluar += [kini] }
    return keluar
}

pub fn arr_windows<T>(a: []T, lebar: int) -> [][]T {
    if lebar < 0 { panik("arr::windows: ukuran tidak boleh negatif, dapat " + str(lebar)) }
    if lebar == 0 { panik("arr::windows: ukuran harus lebih dari 0") }
    var keluar: [][]T = []
    var i = 0
    while i + lebar <= len(a) {
        keluar += [a[i:i + lebar]]
        i += 1
    }
    return keluar
}

pub fn arr_dedup<T>(a: []T) -> []T {
    var keluar: []T = []
    for i, x in a {
        if i == 0 || a[i - 1] != x { keluar += [x] }
    }
    return keluar
}

fn _kunci_tak_sebanding<K>(nama: string, a: K, b: K) -> bool {
    if a != a || b != b {
        panik(nama + ": kunci bertipe `" + typeof(a) + "` dan `" + typeof(b) + "` tidak bisa dibandingkan, jadi urutannya tidak terdefinisi")
    }
    return false
}

fn _punya<T>(a: []T, nilai: T) -> bool {
    for _, x in a { if x == nilai { return true } }
    return false
}

pub fn arr_unique<T>(a: []T) -> []T {
    var keluar: []T = []
    for _, x in a { if !_punya(keluar, x) { keluar += [x] } }
    return keluar
}

pub fn arr_union<T>(a: []T, b: []T) -> []T {
    var keluar: []T = []
    for _, x in a { if !_punya(keluar, x) { keluar += [x] } }
    for _, x in b { if !_punya(keluar, x) { keluar += [x] } }
    return keluar
}

pub fn arr_intersect<T>(a: []T, b: []T) -> []T {
    var keluar: []T = []
    for _, x in a { if _punya(b, x) && !_punya(keluar, x) { keluar += [x] } }
    return keluar
}

pub fn arr_difference<T>(a: []T, b: []T) -> []T {
    var keluar: []T = []
    for _, x in a { if !_punya(b, x) && !_punya(keluar, x) { keluar += [x] } }
    return keluar
}

pub fn arr_enumerate<T>(a: []T) -> [](int, T) {
    var keluar: [](int, T) = []
    for i, x in a { keluar += [(i, x)] }
    return keluar
}

pub fn arr_flatten<T>(a: [][]T) -> []T {
    var keluar: []T = []
    for _, dalam in a { for _, x in dalam { keluar += [x] } }
    return keluar
}

// Pilihan `kunci_lapis_menurut`: elemen yang bukan array disimpan apa adanya.
fn arr_flatten__datar<T>(a: []T) -> []T {
    var keluar: []T = []
    for _, x in a { keluar += [x] }
    return keluar
}

fn arr_flatten__campur<T>(a: []T) -> []T {
    var keluar: []T = []
    for _, x in a {
        if typeof(x) == "array" { for _, y in x { keluar += [y] } } else { keluar += [x] }
    }
    return keluar
}

pub fn arr_insert<T>(a: []T, i0: int, v: T) -> []T {
    let i = i0 < 0 $ i0 + len(a) : i0
    if i < 0 || i > len(a) { panik("arr::insert: index " + str(i0) + " di luar batas (panjang " + str(len(a)) + ")") }
    var keluar: []T = []
    for j, x in a {
        if j == i { keluar += [v] }
        keluar += [x]
    }
    if i == len(a) { keluar += [v] }
    return keluar
}

pub fn arr_remove<T>(a: []T, i0: int) -> ([]T, T) {
    let i = i0 < 0 $ i0 + len(a) : i0
    if i < 0 || i >= len(a) { panik("arr::remove: index " + str(i0) + " di luar batas (panjang " + str(len(a)) + ")") }
    var keluar: []T = []
    for j, x in a { if j != i { keluar += [x] } }
    return (keluar, a[i])
}

// Batas `interpreter::cek_batas_elemen` (MAKS_ELEMEN), kalimatnya sama.
fn _batas_elemen(nama: string, n: int) {
    if n > 16777216 {
        panik(nama + ": minta " + str(n) + " elemen sekaligus, batasnya 16777216 — permintaan sebesar itu mematikan prosesnya sebelum sempat menjawab. Cek lagi angkanya")
    }
}

pub fn arr_repeat<T>(a: []T, n: int) -> []T {
    if n < 0 { panik("arr::repeat: jumlah tidak boleh negatif, dapat " + str(n)) }
    _batas_elemen("arr::repeat", n)
    _batas_elemen("arr::repeat", len(a) * n)
    var keluar: []T = []
    for _ in 0..n { for _, x in a { keluar += [x] } }
    return keluar
}

pub fn arr_fill<T>(v: T, n: int) -> []T {
    if n < 0 { panik("arr::fill: jumlah tidak boleh negatif, dapat " + str(n)) }
    _batas_elemen("arr::fill", n)
    var keluar: []T = []
    for _ in 0..n { keluar += [v] }
    return keluar
}

pub fn arr_rotate<T>(a: []T, n: int) -> []T {
    let p = len(a)
    if p == 0 { return a }
    let k = ((n % p) + p) % p
    var keluar: []T = []
    for i in 0..p { keluar += [a[(i + k) % p]] }
    return keluar
}

// Jumlah negatif ditolak seperti acuan; dulu diam-diam memutar ke arah lain (AGI-20261119-43).
pub fn arr_rotate_left<T>(a: []T, n: int = 1) -> []T {
    if n < 0 { panik("index tidak boleh negatif: " + str(n)) }
    return arr_rotate(a, n)
}

pub fn arr_rotate_right<T>(a: []T, n: int = 1) -> []T {
    if n < 0 { panik("index tidak boleh negatif: " + str(n)) }
    return arr_rotate(a, 0 - n)
}

pub fn arr_join<T>(a: []T, pemisah: string) -> string {
    var keluar = ""
    for i, x in a {
        if i > 0 { keluar += pemisah }
        keluar += str(x)
    }
    return keluar
}

pub fn arr_max_by<T, K>(a: []T, f: fn(T) -> K) -> T {
    if len(a) == 0 { panik("arr::max_by: array kosong tidak punya nilai terbesar") }
    var terbaik = a[0]
    var kunci = f(a[0])
    for i, x in a {
        if i > 0 {
            let k = f(x)
            _kunci_tak_sebanding("arr::max_by", k, kunci)
            if k > kunci {
                terbaik = x
                kunci = k
            }
        }
    }
    return terbaik
}

pub fn arr_min_by<T, K>(a: []T, f: fn(T) -> K) -> T {
    if len(a) == 0 { panik("arr::min_by: array kosong tidak punya nilai terkecil") }
    var terbaik = a[0]
    var kunci = f(a[0])
    for i, x in a {
        if i > 0 {
            let k = f(x)
            _kunci_tak_sebanding("arr::min_by", k, kunci)
            if k < kunci {
                terbaik = x
                kunci = k
            }
        }
    }
    return terbaik
}

pub fn arr_partition<T, B>(a: []T, f: fn(T) -> B) -> ([]T, []T) {
    var ya: []T = []
    var tidak: []T = []
    for _, x in a { if f(x) { ya += [x] } else { tidak += [x] } }
    return (ya, tidak)
}

pub fn arr_zip<A, B>(a: []A, b: []B) -> [](A, B) {
    var keluar: [](A, B) = []
    for i, x in a { if i < len(b) { keluar += [(x, b[i])] } }
    return keluar
}

pub fn arr_zip_with<A, B, C>(a: []A, b: []B, f: fn(A, B) -> C) -> []C {
    var keluar: []C = []
    for i, x in a { if i < len(b) { keluar += [f(x, b[i])] } }
    return keluar
}

pub fn arr_mean<T>(a: []T) -> float {
    if len(a) == 0 { panik("arr::mean: array kosong tidak punya rata-rata") }
    var jumlah = 0.0
    for _, x in a { jumlah += x as float }
    return jumlah / (len(a) as float)
}

pub fn arr_variance<T>(a: []T) -> float {
    if len(a) == 0 { panik("arr::variance: array kosong tidak punya variansi") }
    let m = arr_mean(a)
    var jumlah = 0.0
    for _, x in a {
        let d = (x as float) - m
        jumlah += d * d
    }
    return jumlah / (len(a) as float)
}

pub fn arr_std_dev<T>(a: []T) -> float {
    if len(a) == 0 { panik("arr::std_dev: array kosong tidak punya simpangan baku") }
    return math::sqrt(arr_variance(a))
}

pub fn arr_median<T>(a: []T) -> float {
    if len(a) == 0 { panik("arr::median: array kosong tidak punya median") }
    for _, x in a { if x != x { panik("arr::median: array mengandung NaN, urutannya tidak terdefinisi") } }
    let s = arr::sort(a)
    let p = len(s)
    if p % 2 == 1 { return s[p / 2] as float }
    return ((s[p / 2 - 1] as float) + (s[p / 2] as float)) / 2.0
}

pub fn arr_sort_desc<T>(a: []T) -> []T {
    if len(a) > 1 {
        for _, x in a {
            if x != x {
                panik("arr::sort_desc: tidak bisa membandingkan `" + typeof(x) + "` dengan `" + typeof(x) + "`, jadi urutannya tidak terdefinisi. Samakan dulu tipe isinya, atau pakai `sort_by_key` untuk menentukan sendiri dasar pengurutannya")
            }
        }
    }
    // Menurun dan STABIL (yang setara tetap urutan aslinya, `[2, 2.0]`), seperti acuan yang membalik
    // pembandingnya: masukan dibalik dulu. Dulu `reverse(sort(a))` menukar yang setara diam-diam.
    return arr::reverse(arr::sort(arr::reverse(a)))
}

pub fn arr_binary_search<T>(a: []T, v: T) -> Option<int> {
    var lo = 0
    var hi = len(a)
    while lo < hi {
        let m = (lo + hi) / 2
        if a[m] != a[m] || v != v {
            panik("binary_search: `" + str(a[m]) + "` (tipe " + typeof(a[m]) + ") tidak bisa dibandingkan dengan yang dicari `" + str(v) + "` (tipe " + typeof(v) + ")")
        }
        if a[m] == v { return Some(m) }
        if a[m] < v { lo = m + 1 } else { hi = m }
    }
    return None
}

pub fn arr_group_by<T, K>(a: []T, f: fn(T) -> K) -> dict<[]T> {
    var keluar: dict<[]T> = dict::new()
    for _, x in a {
        let k = str(f(x))
        var isi: []T = dict::get_or(keluar, k, [])
        isi += [x]
        keluar[k] = isi
    }
    return keluar
}

pub fn arr_sort_by_key<T, K>(a: []T, f: fn(T) -> K) -> []T {
    var kunci: []K = []
    for _, x in a { kunci += [f(x)] }
    var urut: []int = []
    for i in 0..len(a) {
        var j = len(urut)
        urut += [i]
        if j > 0 { _kunci_tak_sebanding("arr::sort_by_key", kunci[urut[j - 1]], kunci[i]) }
        while j > 0 && kunci[urut[j - 1]] > kunci[i] {
            urut[j] = urut[j - 1]
            j -= 1
        }
        urut[j] = i
    }
    var keluar: []T = []
    for _, i in urut { keluar += [a[i]] }
    return keluar
}

pub fn arr_sort_by<T>(a: []T, f: fn(T, T) -> int) -> []T {
    var keluar: []T = []
    for _, x in a {
        var lo = 0
        var hi = len(keluar)
        while lo < hi {
            let tengah = (lo + hi) / 2
            if f(x, keluar[tengah]) < 0 { hi = tengah } else { lo = tengah + 1 }
        }
        keluar = arr_insert(keluar, lo, x)
    }
    return keluar
}

pub fn dict_items<V>(d: dict<V>) -> [](string, V) {
    var keluar: [](string, V) = []
    for k, v in d { keluar += [(k, v)] }
    return keluar
}

pub fn str_len(s: string) -> int { return len(s) }

pub fn str_is_empty(s: string) -> bool { return len(s) == 0 }

pub fn str_to_lowercase(s: string) -> string { return str::lower(s) }

pub fn str_to_uppercase(s: string) -> string { return str::upper(s) }

pub fn str_strip_prefix(s: string, awalan: string) -> string {
    if str::starts_with(s, awalan) { return s[len(awalan):] }
    return s
}

pub fn str_strip_suffix(s: string, akhiran: string) -> string {
    if str::ends_with(s, akhiran) { return s[:len(s) - len(akhiran)] }
    return s
}

pub fn str_char_at(s: string, i0: int) -> rune {
    let i = i0 < 0 $ i0 + len(s) : i0
    if i < 0 || i >= len(s) { panik("str::char_at: index " + str(i0) + " di luar batas (panjang " + str(len(s)) + ")") }
    return s[i]
}

pub fn str_chars(s: string) -> []rune {
    var keluar: []rune = []
    for _, c in s { keluar += [c] }
    return keluar
}

pub fn str_count(s: string, bagian: string) -> int {
    if len(bagian) == 0 { return len(s) + 1 }
    return len(str::split(s, bagian)) - 1
}

pub fn str_lines(s: string) -> []string {
    var keluar: []string = []
    let potong = str::split(s, "\n")
    for i, baris in potong {
        if i == len(potong) - 1 && len(baris) == 0 { continue }
        if i < len(potong) - 1 && str::ends_with(baris, "\r") { keluar += [baris[:len(baris) - 1]] } else { keluar += [baris] }
    }
    return keluar
}

fn _isi_pad<I>(nama: string, isi: I) -> string {
    let t = str(isi)
    if len(t) != 1 {
        panik(nama + ": isinya harus tepat satu karakter, dapat " + str(len(t)) + " karakter\n  bantuan: untuk pola berulang, bangun dulu dengan `str::repeat`, lalu potong dengan `str::slice`")
    }
    return t
}

fn _lebar_pad(lebar: int) -> int {
    if lebar < 0 { panik("index tidak boleh negatif: " + str(lebar)) }
    return lebar
}

pub fn str_pad_left<T, I>(v: T, lebar: int, isi: I = " ") -> string {
    let s = str(v)
    let w = _lebar_pad(lebar)
    let c = _isi_pad("str::pad_left", isi)
    if len(s) >= w { return s }
    return str::repeat(c, w - len(s)) + s
}

pub fn str_pad_right<T, I>(v: T, lebar: int, isi: I = " ") -> string {
    let s = str(v)
    let w = _lebar_pad(lebar)
    let c = _isi_pad("str::pad_right", isi)
    if len(s) >= w { return s }
    return s + str::repeat(c, w - len(s))
}

pub fn str_center<T, I>(v: T, lebar: int, isi: I = " ") -> string {
    let s = str(v)
    let w = _lebar_pad(lebar)
    let c = _isi_pad("str::center", isi)
    if len(s) >= w { return s }
    let total = w - len(s)
    let kiri = total / 2
    return str::repeat(c, kiri) + s + str::repeat(c, total - kiri)
}

// Argumen angka `math::`: `x as float` menerima `bool` dan teks, acuannya tidak.
fn _angka<A>(nama: string, x: A) -> float {
    let t = typeof(x)
    if t != "int" && t != "float" { panik(nama + ": butuh angka, dapat `" + t + "`") }
    return x as float
}

pub fn math_log<A, B>(x: A, basis: B) -> float {
    let v = _angka("math::log", x)
    return math::ln(v) / math::ln(_angka("math::log", basis))
}

pub fn math_degrees<A>(x: A) -> float { return _angka("math::degrees", x) * (180.0 / math::PI) }

pub fn math_radians<A>(x: A) -> float { return _angka("math::radians", x) * (math::PI / 180.0) }

pub fn math_is_finite<A>(x: A) -> bool {
    let v = _angka("math::is_finite", x)
    return v - v == 0.0
}

pub fn str_ljust<T, I>(v: T, lebar: int, isi: I = " ") -> string {
    let s = str(v)
    let w = _lebar_pad(lebar)
    let c = _isi_pad("str::ljust", isi)
    if len(s) >= w { return s }
    return s + str::repeat(c, w - len(s))
}

pub fn str_rjust<T, I>(v: T, lebar: int, isi: I = " ") -> string {
    let s = str(v)
    let w = _lebar_pad(lebar)
    let c = _isi_pad("str::rjust", isi)
    if len(s) >= w { return s }
    return str::repeat(c, w - len(s)) + s
}

pub fn rand_int(lo: int, hi: int) -> int {
    if hi < lo { panik("rand::int: hi (" + str(hi) + ") harus >= lo (" + str(lo) + ")") }
    // Rentang yang lebarnya tidak muat 64 bit: diambil sampel 64 bit penuh lalu ditolak yang di luar (peluang
    // diterima >= 1/2) — dulu `hi - lo + 1` meluap (AGI-20261119-43).
    if (lo < 0 && hi > 9223372036854775807 + lo) || hi - lo == 9223372036854775807 {
        while true {
            let a = lapis::acak()
            let v = lapis::acak() % 2 == 0 $ a : (0 - a) - 1
            if v >= lo && v <= hi { return v }
        }
    }
    return lo + lapis::acak() % (hi - lo + 1)
}

pub fn rand_float() -> float { return ((lapis::acak() / 1024) as float) / 9007199254740992.0 }

pub fn rand_bool() -> bool { return lapis::acak() % 2 == 1 }

pub fn rand_choice<T>(a: []T) -> T {
    if len(a) == 0 { panik("rand::choice: array kosong, tidak ada yang bisa dipilih") }
    return a[lapis::acak() % len(a)]
}

pub fn rand_shuffle<T>(a: []T) -> []T {
    var keluar: []T = []
    for _, x in a { keluar += [x] }
    var i = len(keluar) - 1
    while i > 0 {
        let j = lapis::acak() % (i + 1)
        let t = keluar[i]
        keluar[i] = keluar[j]
        keluar[j] = t
        i -= 1
    }
    return keluar
}

pub fn rand_sample<T>(a: []T, n: int) -> []T {
    if n < 0 { panik("index tidak boleh negatif: " + str(n)) }
    let acak = rand_shuffle(a)
    if n >= len(acak) { return acak }
    return acak[0:n]
}

pub fn arr_shuffle<T>(a: []T) -> []T { return rand_shuffle(a) }

pub fn arr_sample<T>(a: []T, n: int = 1) -> []T { return rand_sample(a, n) }

pub fn str_substr(s: string, mulai: int, panjang: int = 9223372036854775807) -> string {
    let p = len(s)
    let tulis = mulai
    if mulai < 0 { mulai = p + mulai }
    if mulai < 0 || mulai > p { panik("str::substr: posisi awal " + str(tulis) + " di luar jangkauan — string ini cuma " + str(p) + " karakter") }
    if panjang < 0 { panik("index tidak boleh negatif: " + str(panjang)) }
    if panjang >= p - mulai { return s[mulai:] }
    return s[mulai:mulai + panjang]
}

fn _lantai(a: int, b: int) -> int {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { return q - 1 }
    return q
}

fn _sisa(a: int, b: int) -> int { return a - _lantai(a, b) * b }

// Howard Hinnant, `civil_from_days`: hari sejak epoch -> (tahun, bulan, tanggal).
fn _tanggal(hari: int) -> (int, int, int) {
    let z = hari + 719468
    let era = _lantai(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    var m = mp - 9
    if mp < 10 { m = mp + 3 }
    if m <= 2 { return (y + 1, m, d) }
    return (y, m, d)
}

// Jangkauan cap waktu sama dengan acuan (`time_ext::BATAS_MS`); dulu tahun 287168 dijawab (AGI-20261119-51).
fn _hari(ms: int) -> int {
    if ms > 8640000000000000 || ms < -8640000000000000 {
        panik("time:: cap waktu `" + str(ms) + "` milidetik di luar jangkauan — yang sah -8640000000000000 sampai 8640000000000000 (sekitar 275 ribu tahun dari 1970)")
    }
    return _lantai(_lantai(ms, 1000), 86400)
}

fn _detik_hari(ms: int) -> int {
    let _ = _hari(ms)
    return _sisa(_lantai(ms, 1000), 86400)
}

pub fn time_year(ms: int = time_now_ms()) -> int { return _tanggal(_hari(ms)).0 }
pub fn time_month(ms: int = time_now_ms()) -> int { return _tanggal(_hari(ms)).1 }
pub fn time_day(ms: int = time_now_ms()) -> int { return _tanggal(_hari(ms)).2 }
pub fn time_hour(ms: int = time_now_ms()) -> int { return _detik_hari(ms) / 3600 }
pub fn time_minute(ms: int = time_now_ms()) -> int { return (_detik_hari(ms) % 3600) / 60 }
pub fn time_second(ms: int = time_now_ms()) -> int { return _detik_hari(ms) % 60 }

pub fn time_weekday(ms: int = time_now_ms()) -> string {
    let nama = ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"]
    return nama[((_hari(ms) % 7) + 10) % 7]
}

fn _nol(n: int, lebar: int) -> string {
    // Tanda di depan bantalan, seperti acuan: tahun -1 jadi `-001`, bukan `00-1` (AGI-20261119-43).
    if n < 0 { return "-" + _nol(0 - n, lebar - 1) }
    var s = str(n)
    while len(s) < lebar { s = "0" + s }
    return s
}

pub fn time_format(ms: int = time_now_ms(), pola: string = "%Y-%m-%d %H:%M:%S") -> string {
    let bulan = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"]
    let t = _tanggal(_hari(ms))
    var keluar = ""
    var persen = false
    for _, c in pola {
        let k = str(c)
        if !persen {
            if k == "%" { persen = true } else { keluar += k }
            continue
        }
        persen = false
        if k == "Y" { keluar += _nol(t.0, 4) }
        else if k == "y" { keluar += _nol((t.0 % 100 + 100) % 100, 2) }
        else if k == "m" { keluar += _nol(t.1, 2) }
        else if k == "d" { keluar += _nol(t.2, 2) }
        else if k == "H" { keluar += _nol(time_hour(ms), 2) }
        else if k == "M" { keluar += _nol(time_minute(ms), 2) }
        else if k == "S" { keluar += _nol(time_second(ms), 2) }
        else if k == "L" { keluar += _nol(_sisa(ms, 1000), 3) }
        else if k == "A" { keluar += time_weekday(ms) }
        else if k == "B" { keluar += bulan[t.1 - 1] }
        else if k == "%" { keluar += "%" }
        else {
            panik("time::format: arahan `%" + k + "` tidak dikenal.\n  bantuan: yang ada — %Y tahun, %y dua digit, %m bulan, %d tanggal, %H jam, %M menit, %S detik, %L milidetik, %A nama hari, %B nama bulan, %% tanda persen")
        }
    }
    if persen { panik("time::format: pola berakhir dengan `%` menggantung") }
    return keluar
}


// Padanan `host::galat_io` untuk nomor errno Linux; kalimatnya harus sama persis.
fn _galat_os(kode: int) -> string {
    let n = 0 - kode
    if n == 100000 { return "isinya bukan teks UTF-8 yang sah" }
    if n == 100002 { return "isinya lebih dari 256 MiB, batas satu bacaan utuh (berkas raksasa atau perangkat tanpa ujung seperti /dev/zero tidak dibaca ke memori)" }
    if n == 100001 { return "teksnya memuat karakter NUL, yang tidak bisa diserahkan ke sistem operasi" }
    if n == 2 { return "berkas atau direktorinya tidak ada" }
    if n == 13 || n == 1 { return "tidak diizinkan (izin aksesnya kurang)" }
    if n == 17 { return "sudah ada" }
    if n == 21 { return "itu direktori, bukan berkas" }
    if n == 20 { return "itu bukan direktori" }
    if n == 39 { return "direktorinya tidak kosong" }
    if n == 30 { return "sistem berkasnya cuma bisa dibaca" }
    if n == 28 { return "penyimpanannya penuh" }
    if n == 27 { return "berkasnya terlalu besar" }
    if n == 36 { return "nama berkasnya tidak sah" }
    if n == 16 { return "sedang dipakai" }
    if n == 18 { return "asal dan tujuannya di perangkat berbeda" }
    if n == 12 { return "memorinya habis" }
    if n == 32 { return "pipanya sudah putus" }
    return "ditolak sistem operasi (galat nomor " + str(n) + ")"
}

// Durasi seperti `{}` milik Rust menulisnya: pecahan bulat tanpa `.0`.
fn _durasi(d: float) -> string {
    if d == math::floor(d) && d < 9000000000000000000.0 && d > -9000000000000000000.0 { return str(d as int) }
    return str(d)
}

pub fn time_now_ms() -> int { return lapis::os(14, "", "", 0).0 / 1000 }

pub fn time_now() -> float { return (time_now_ms() as float) / 1000.0 }

pub fn time_sleep_ms<T>(ms: T) {
    let d = ms as float
    if d != d { panik("time::sleep_ms: butuh angka (milidetik), dapat `float`") }
    if d > 315360000000.0 { panik("time::sleep_ms: durasi `" + _durasi(d) + "` milidetik tidak masuk akal — pakai angka yang wajar (0 untuk tanpa delay)") }
    if d > 0.0 { lapis::os(15, "", "", (d * 1000.0) as int) }
}

pub fn time_sleep<T>(detik: T) {
    let d = detik as float
    if d != d || d - d != 0.0 || d > 315360000.0 { panik("time::sleep: durasi `" + _durasi(d) + "` detik tidak masuk akal — pakai angka detik yang wajar (0 untuk tanpa delay)") }
    if d > 0.0 { lapis::os(15, "", "", (d * 1000000.0) as int) }
}

pub fn env_get(nama: string) -> Option<string> {
    let r = lapis::os(12, nama, "", 0)
    if r.0 == 1 { return Some(r.1) }
    return None
}

pub fn env_get_or<V>(nama: string, cadangan: V) -> string {
    let r = lapis::os(12, nama, "", 0)
    if r.0 == 1 { return r.1 }
    return str(cadangan)
}

pub fn env_os() -> string {
    let r = lapis::os(26, "", "", 0)
    if r.0 < 0 { panik("env::os: tidak bisa dibaca: " + _galat_os(r.0)) }
    return r.1
}

pub fn env_arch() -> string {
    let r = lapis::os(27, "", "", 0)
    if r.0 < 0 { panik("env::arch: tidak bisa dibaca: " + _galat_os(r.0)) }
    return r.1
}

pub fn env_exe() -> string {
    let r = lapis::os(25, "", "", 0)
    if r.0 < 0 { panik("env::exe: tidak bisa dibaca: " + _galat_os(r.0)) }
    return r.1
}

pub fn env_set<V>(nama: string, nilai: V) {
    let z = str(rune(0))
    if nama == "" || str::contains(nama, "=") || str::contains(nama, z) {
        panik("env::set: nama variabel " + _kutip_debug(nama) + " tidak sah — tidak boleh kosong, dan tidak boleh berisi `=` atau karakter NUL")
    }
    let isi = str(nilai)
    if str::contains(isi, z) { panik("env::set: nilai untuk `" + nama + "` berisi karakter NUL, dan variabel lingkungan tidak bisa menyimpannya") }
    let r = lapis::os(13, nama, isi, 0)
    if r.0 < 0 { panik("env::set `" + nama + "`: " + _galat_os(r.0)) }
}

// Bentuk `{:?}` Rust untuk teks: dikutip, `\`, `"`, NUL dan tiga pemisah baris diloloskan.
fn _kutip_debug(s: string) -> string {
    var k = "\""
    for _, c in str::chars(s) {
        let n = c as int
        if n == 0 { k += "\\0" } else if n == 10 { k += "\\n" } else if n == 13 { k += "\\r" }
        else if n == 9 { k += "\\t" } else if n == 34 { k += "\\\"" } else if n == 92 { k += "\\\\" }
        else { k += str(c) }
    }
    return k + "\""
}

pub fn fs_read(path: string) -> string {
    let r = lapis::os(1, path, "", 1)
    if r.0 < 0 { panik("fs::read '" + path + "': " + _galat_os(r.0)) }
    return r.1
}

// `fs::read` yang menjawab `Result` (berkas hilang atau bukan teks jadi `Err`): tanpa jembatan, jadi juga di kernel.
pub fn fs_try_read(path: string) -> Result<string, string> {
    let r = lapis::os(1, path, "", 1)
    if r.0 < 0 { return Err("fs::try_read '" + path + "': " + _galat_os(r.0)) }
    return Ok(r.1)
}

pub fn fs_write<V>(path: string, isi: V) {
    let r = lapis::os(2, path, str(isi), 0)
    if r.0 < 0 { panik("fs::write '" + path + "': " + _galat_os(r.0)) }
}

pub fn fs_append<V>(path: string, isi: V) {
    let r = lapis::os(3, path, str(isi), 0)
    if r.0 < 0 { panik("fs::append '" + path + "': " + _galat_os(r.0)) }
}

pub fn fs_exists(path: string) -> bool { return lapis::os(4, path, "", 0).0 == 1 }

pub fn fs_is_dir(path: string) -> bool { return lapis::os(7, path, "", 0).0 == 1 }

pub fn fs_is_file(path: string) -> bool { return lapis::os(8, path, "", 0).0 == 1 }

pub fn fs_is_symlink(path: string) -> bool { return lapis::os(18, path, "", 0).0 == 1 }

pub fn fs_delete(path: string) -> bool { return lapis::os(5, path, "", 0).0 == 0 }

pub fn fs_rmdir(path: string) -> bool { return lapis::os(24, path, "", 0).0 == 0 }

pub fn fs_mkdir(path: string) -> bool { return lapis::os(9, path, "", 0).0 == 0 }

pub fn fs_rename(dari: string, ke: string) -> bool { return lapis::os(10, dari, ke, 0).0 == 0 }

pub fn fs_copy(dari: string, ke: string) -> bool {
    let r = lapis::os(1, dari, "", 0)
    if r.0 < 0 { return false }
    return lapis::os(2, ke, r.1, 0).0 == 0
}

pub fn fs_size(path: string) -> int {
    let r = lapis::os(6, path, "", 0)
    if r.0 < 0 { panik("fs::size '" + path + "': " + _galat_os(r.0)) }
    return r.0
}

pub fn fs_cwd() -> string { return lapis::os(17, "", "", 0).1 }

pub fn fs_temp_dir() -> string {
    let r = lapis::os(12, "TMPDIR", "", 0)
    if r.0 == 1 && len(r.1) > 0 { return r.1 }
    return "/tmp"
}

fn _nama_isi(teks: string, jumlah: int) -> []string {
    if jumlah == 0 {
        let kosong: []string = []
        return kosong
    }
    return str::split(teks, "\u0000")
}

pub fn fs_ls(path: string) -> []string {
    let r = lapis::os(11, path, "", 0)
    if r.0 < 0 { panik("fs::ls '" + path + "': " + _galat_os(r.0)) }
    return _nama_isi(r.1, r.0)
}

pub fn fs_read_lines(path: string) -> []string {
    let r = lapis::os(1, path, "", 1)
    if r.0 < 0 { panik("fs::read_lines '" + path + "': " + _galat_os(r.0)) }
    return str_lines(r.1)
}

pub fn fs_write_lines<V>(path: string, baris: []V) {
    var isi = ""
    for _, b in baris { isi += str(b) + "\n" }
    let r = lapis::os(2, path, isi, 0)
    if r.0 < 0 { panik("fs::write_lines '" + path + "': " + _galat_os(r.0)) }
}

pub fn fs_basename(p: string) -> string {
    var s = p
    while len(s) > 1 && str::ends_with(s, "/") { s = s[:len(s) - 1] }
    let bagian = str::split(s, "/")
    return bagian[len(bagian) - 1]
}

pub fn fs_dirname(p: string) -> string {
    var s = p
    while len(s) > 1 && str::ends_with(s, "/") { s = s[:len(s) - 1] }
    if len(s) == 0 || s == "/" { return "." }
    let bagian = str::split(s, "/")
    if len(bagian) == 1 { return "" }
    var induk = s[:len(s) - len(bagian[len(bagian) - 1]) - 1]
    while len(induk) > 1 && str::ends_with(induk, "/") { induk = induk[:len(induk) - 1] }
    if len(induk) == 0 { return "/" }
    return induk
}

pub fn fs_join(a: string, b: string) -> string {
    if str::starts_with(b, "/") || len(a) == 0 { return b }
    if str::ends_with(a, "/") { return a + b }
    return a + "/" + b
}

pub fn file_read(path: string) -> Result<string, string> {
    let r = lapis::os(1, path, "", 1)
    if r.0 < 0 { return Err("file::read: gagal baca `" + path + "` — " + _galat_os(r.0)) }
    return Ok(r.1)
}

pub fn file_read_lines(path: string) -> Result<[]string, string> {
    let r = lapis::os(1, path, "", 1)
    if r.0 < 0 { return Err("file::read_lines: gagal baca `" + path + "` — " + _galat_os(r.0)) }
    return Ok(str_lines(r.1))
}

pub fn file_write<V>(path: string, isi: V) -> Result<(), string> {
    let r = lapis::os(2, path, str(isi), 0)
    if r.0 < 0 { return Err("file::write: gagal tulis `" + path + "` — " + _galat_os(r.0)) }
    return Ok(())
}

pub fn file_append<V>(path: string, isi: V) -> Result<(), string> {
    let r = lapis::os(3, path, str(isi), 0)
    if r.0 < 0 { return Err("file::append: gagal tambah isi ke `" + path + "` — " + _galat_os(r.0)) }
    return Ok(())
}

pub fn file_delete(path: string) -> Result<(), string> {
    let r = lapis::os(23, path, "", 0)
    if r.0 < 0 { return Err("file::delete: gagal hapus `" + path + "` — " + _galat_os(r.0)) }
    return Ok(())
}

pub fn file_exists(path: string) -> bool { return lapis::os(4, path, "", 0).0 == 1 }

pub fn file_list_dir(path: string) -> Result<[]string, string> {
    let r = lapis::os(11, path, "", 0)
    if r.0 < 0 { return Err("file::list_dir: gagal buka folder `" + path + "` — " + _galat_os(r.0)) }
    return Ok(_nama_isi(r.1, r.0))
}

// Struct dibaca lewat field-nya seperti acuan: `dict { ...objek }`; cabang `typeof` dilipat saat kompilasi.
pub fn json_get(objek, kunci: string) {
    if typeof(objek) == "dict" { return dict::get(objek, kunci) }
    return dict::get(dict { ...objek }, kunci)
}

pub fn json_has(objek, kunci: string) -> bool {
    if typeof(objek) == "dict" { return dict::has(objek, kunci) }
    return dict::has(dict { ...objek }, kunci)
}

pub fn json_keys(objek) -> []string {
    if typeof(objek) == "dict" { return dict::keys(objek) }
    return dict::keys(dict { ...objek })
}

pub fn json_values(objek) {
    if typeof(objek) == "dict" { return dict::values(objek) }
    return dict::values(dict { ...objek })
}

pub fn json_set(objek, kunci: string, nilai) { return dict::set(objek, kunci, nilai) }

pub fn json_merge(a, b) { return dict::merge(a, b) }

fn _telusuri(keluar: []string, d: string, sisa: int) -> []string {
    if sisa == 0 { return keluar }
    let r = lapis::os(11, d, "", 0)
    if r.0 < 0 { return keluar }
    var hasil = keluar
    for _, n in _nama_isi(r.1, r.0) {
        let f = fs_join(d, n)
        if lapis::os(7, f, "", 0).0 == 1 && lapis::os(18, f, "", 0).0 != 1 {
            hasil = _telusuri(hasil, f, sisa - 1)
        } else {
            hasil += [f]
        }
    }
    return hasil
}

pub fn fs_walk(dir: string) -> []string {
    if lapis::os(4, dir, "", 0).0 != 1 { panik("fs::walk '" + dir + "': " + _galat_os(0 - 2)) }
    if lapis::os(7, dir, "", 0).0 != 1 { panik("fs::walk '" + dir + "': bukan direktori — `fs::walk` menelusuri isi sebuah direktori") }
    let kosong: []string = []
    return _telusuri(kosong, dir, 64)
}

pub fn fs_abs(path: string) -> string {
    var bagian: []string = []
    if !str::starts_with(path, "/") {
        for _, b in str::split(fs_cwd(), "/") { if len(b) > 0 { bagian += [b] } }
    }
    for _, b in str::split(path, "/") {
        if len(b) == 0 || b == "." { continue }
        if b == ".." {
            if len(bagian) > 0 { bagian = bagian[:len(bagian) - 1] }
            continue
        }
        bagian += [b]
    }
    return "/" + str::join(bagian, "/")
}

pub fn fs_is_writable(path: string) -> bool { return lapis::os(19, path, "", 0).0 == 1 }

pub fn fs_chmod(path: string, mode: int) {
    if mode < 0 || mode > 4294967295 { panik("fs::chmod: mode `" + str(mode) + "` di luar jangkauan") }
    let r = lapis::os(20, path, "", mode)
    if r.0 < 0 { panik("fs::chmod '" + path + "': " + _galat_os(r.0)) }
}

pub fn env_args() -> []string {
    var keluar: []string = []
    for i in 0..lapis::os(21, "", "", 0).0 { keluar += [lapis::os(22, "", "", i).1] }
    return keluar
}

// Isi `jawa::buffer_from_hex` (`codegen_panggil` membangun buffer runtime-nya di sekelilingnya):
// lewat jembatan buffer-nya lahir di registri `jrgc`, dan pegangannya ditolak `buffer_get`.
fn _isi_buffer_hex(teks: string) -> []int {
    let r = crypto::hex_decode_bytes(teks)
    if r.is_err() { panik("jawa::buffer_from_hex: " + r.unwrap_err()) }
    return r.unwrap()
}

// ── crypto:: sidik dan pengodean (murni, tanpa jembatan: juga jalan di kernel `--bebas`) ──
// Isi = teks (byte UTF-8-nya) atau array byte; kalimat galatnya sama dengan acuan.
fn _isi_byte<V>(isi: V, nama: string) -> []int {
    if typeof(isi) == "string" {
        let t: string = isi
        return str::bytes(t)
    }
    if typeof(isi) == "array" {
        var hasil: []int = []
        for i, b in isi {
            if typeof(b) != "int" { panik(nama + ": elemen ke-" + str(i) + " array byte harus bilangan 0 sampai 255, dapat `" + typeof(b) + "`") }
            if b < 0 || b > 255 { panik(nama + ": elemen ke-" + str(i) + " array byte harus 0 sampai 255, dapat " + str(b)) }
            hasil = arr::push(hasil, b)
        }
        return hasil
    }
    panik(nama + ": butuh string, dapat `" + typeof(isi) + "`")
}

fn _heks_byte(b: []int) -> string {
    let d = "0123456789abcdef"
    var s = ""
    for _, x in b { s = s + str::char_at(d, x >> 4) + str::char_at(d, x & 15) }
    return s
}

fn _putar32(x: int, n: int) -> int { return ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF }

pub fn crypto_hex_encode<V>(isi: V) -> string { return _heks_byte(_isi_byte(isi, "crypto::hex_encode")) }

pub fn crypto_base64_encode<V>(isi: V) -> string {
    let b = _isi_byte(isi, "crypto::base64_encode")
    let abj = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    var s = ""
    var i = 0
    while i < len(b) {
        let n = len(b) - i
        let x = (b[i] << 16) | ((n > 1 $ b[i + 1] : 0) << 8) | (n > 2 $ b[i + 2] : 0)
        s = s + str::char_at(abj, (x >> 18) & 63) + str::char_at(abj, (x >> 12) & 63)
        s = s + (n > 1 $ str::char_at(abj, (x >> 6) & 63) : "=") + (n > 2 $ str::char_at(abj, x & 63) : "=")
        i += 3
    }
    return s
}

pub fn crypto_crc32<V>(isi: V) -> int {
    var c = 0xFFFFFFFF
    for _, x in _isi_byte(isi, "crypto::crc32") {
        c = c ^ x
        for _ in 0..8 { c = (c & 1) == 1 $ ((c >> 1) ^ 0xEDB88320) : (c >> 1) }
    }
    return c ^ 0xFFFFFFFF
}

// Blok 64 byte berpanjang-bit di ujung (big-endian untuk SHA, little-endian untuk MD5).
fn _bantalan(b: []int, besar_dulu: bool) -> []int {
    let bit = len(b) * 8
    var m = arr::push(b, 0x80)
    while len(m) % 64 != 56 { m = arr::push(m, 0) }
    for k in 0..8 {
        let geser = besar_dulu $ (7 - k) * 8 : k * 8
        m = arr::push(m, (bit >> geser) & 255)
    }
    return m
}

pub fn crypto_sha256<V>(isi: V) -> string {
    let kk = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
    var h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    let m = _bantalan(_isi_byte(isi, "crypto::sha256"), true)
    var w = arr::fill(0, 64)
    var p = 0
    while p < len(m) {
        for t in 0..16 { w[t] = (m[p + t * 4] << 24) | (m[p + t * 4 + 1] << 16) | (m[p + t * 4 + 2] << 8) | m[p + t * 4 + 3] }
        // w[16..64]: `t` adalah indeks dikurangi 16.
        for t in 0..48 {
            let a = w[t + 1]
            let b = w[t + 14]
            let s0 = (_putar32(a, 25) ^ _putar32(a, 14)) ^ (a >> 3)
            let s1 = (_putar32(b, 15) ^ _putar32(b, 13)) ^ (b >> 10)
            w[t + 16] = (w[t] + s0 + w[t + 9] + s1) & 0xFFFFFFFF
        }
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        var f = h[5]
        var g = h[6]
        var hh = h[7]
        for t in 0..64 {
            let s1 = (_putar32(e, 26) ^ _putar32(e, 21)) ^ _putar32(e, 7)
            let ch = (e & f) ^ ((e ^ 0xFFFFFFFF) & g)
            let t1 = (hh + s1 + ch + kk[t] + w[t]) & 0xFFFFFFFF
            let s0 = (_putar32(a, 30) ^ _putar32(a, 19)) ^ _putar32(a, 10)
            let mj = ((a & b) ^ (a & c)) ^ (b & c)
            hh = g
            g = f
            f = e
            e = (d + t1) & 0xFFFFFFFF
            d = c
            c = b
            b = a
            a = (t1 + s0 + mj) & 0xFFFFFFFF
        }
        h = [(h[0] + a) & 0xFFFFFFFF, (h[1] + b) & 0xFFFFFFFF, (h[2] + c) & 0xFFFFFFFF, (h[3] + d) & 0xFFFFFFFF,
            (h[4] + e) & 0xFFFFFFFF, (h[5] + f) & 0xFFFFFFFF, (h[6] + g) & 0xFFFFFFFF, (h[7] + hh) & 0xFFFFFFFF]
        p += 64
    }
    var keluar: []int = []
    for _, x in h { for k in 0..4 { keluar = arr::push(keluar, (x >> ((3 - k) * 8)) & 255) } }
    return _heks_byte(keluar)
}

pub fn crypto_sha1<V>(isi: V) -> string {
    var h = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0]
    let m = _bantalan(_isi_byte(isi, "crypto::sha1"), true)
    var w = arr::fill(0, 80)
    var p = 0
    while p < len(m) {
        for t in 0..16 { w[t] = (m[p + t * 4] << 24) | (m[p + t * 4 + 1] << 16) | (m[p + t * 4 + 2] << 8) | m[p + t * 4 + 3] }
        for t in 0..64 { w[t + 16] = _putar32(((w[t + 13] ^ w[t + 8]) ^ w[t + 2]) ^ w[t], 1) }
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        for t in 0..80 {
            var f = 0
            var k = 0
            if t < 20 { f = (b & c) | ((b ^ 0xFFFFFFFF) & d); k = 0x5A827999 }
            else if t < 40 { f = (b ^ c) ^ d; k = 0x6ED9EBA1 }
            else if t < 60 { f = ((b & c) | (b & d)) | (c & d); k = 0x8F1BBCDC }
            else { f = (b ^ c) ^ d; k = 0xCA62C1D6 }
            let tmp = (_putar32(a, 5) + f + e + k + w[t]) & 0xFFFFFFFF
            e = d
            d = c
            c = _putar32(b, 30)
            b = a
            a = tmp
        }
        h = [(h[0] + a) & 0xFFFFFFFF, (h[1] + b) & 0xFFFFFFFF, (h[2] + c) & 0xFFFFFFFF, (h[3] + d) & 0xFFFFFFFF,
            (h[4] + e) & 0xFFFFFFFF]
        p += 64
    }
    var keluar: []int = []
    for _, x in h { for k in 0..4 { keluar = arr::push(keluar, (x >> ((3 - k) * 8)) & 255) } }
    return _heks_byte(keluar)
}

pub fn crypto_md5<V>(isi: V) -> string {
    let s = [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10,
        15, 21, 6, 10, 15, 21]
    let kk = [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391]
    var h = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
    let m = _bantalan(_isi_byte(isi, "crypto::md5"), false)
    var p = 0
    while p < len(m) {
        var x = arr::fill(0, 16)
        for t in 0..16 { x[t] = m[p + t * 4] | (m[p + t * 4 + 1] << 8) | (m[p + t * 4 + 2] << 16) | (m[p + t * 4 + 3] << 24) }
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        for i in 0..64 {
            var f = 0
            var g = 0
            if i < 16 { f = (b & c) | ((b ^ 0xFFFFFFFF) & d); g = i }
            else if i < 32 { f = (d & b) | ((d ^ 0xFFFFFFFF) & c); g = (5 * i + 1) % 16 }
            else if i < 48 { f = (b ^ c) ^ d; g = (3 * i + 5) % 16 }
            else { f = c ^ (b | (d ^ 0xFFFFFFFF)); g = (7 * i) % 16 }
            let tmp = d
            d = c
            c = b
            b = (b + _putar32((a + f + kk[i] + x[g]) & 0xFFFFFFFF, s[i])) & 0xFFFFFFFF
            a = tmp
        }
        h = [(h[0] + a) & 0xFFFFFFFF, (h[1] + b) & 0xFFFFFFFF, (h[2] + c) & 0xFFFFFFFF, (h[3] + d) & 0xFFFFFFFF]
        p += 64
    }
    var keluar: []int = []
    for _, v in h { for k in 0..4 { keluar = arr::push(keluar, (v >> (k * 8)) & 255) } }
    return _heks_byte(keluar)
}

// Byte acak dari sumber acak OS (bukan `rand::`), sebagai heksadesimal; kalimat galat sama dengan acuan.
pub fn crypto_random_hex<V>(n: V) -> string {
    if typeof(n) == "int" {
        let k: int = n
        if k < 0 { panik("argumen tidak cocok untuk `crypto::random_hex` — dapat (int), bentuk yang diterima: crypto::random_hex(n)") }
        if k > 16777216 {
            panik("crypto::random_hex: minta " + str(k) + " elemen sekaligus, batasnya 16777216 — permintaan sebesar itu mematikan prosesnya sebelum sempat menjawab. Cek lagi angkanya")
        }
        let r = lapis::os(28, "", "", k)
        if r.0 < 0 { panik("crypto::random_hex: sumber acak yang aman tidak bisa dibaca: " + _galat_os(r.0) + " — angka dari jam bisa ditebak, jadi tidak dipakai untuk kripto") }
        return r.1
    }
    panik("argumen tidak cocok untuk `crypto::random_hex` — dapat (" + typeof(n) + "), bentuk yang diterima: crypto::random_hex(n)")
}

// Lebar tampil (kolom layar) — tabel yang sama dengan `jrgc` (`src/lebar.rs`, salinan C diturunkan generatornya).
pub fn term_lebar<V>(s: V) -> int {
    if typeof(s) == "string" {
        let t: string = s
        var n = 0
        for _, c in str::chars(t) { n += lapis::os(29, "", "", c as int).0 }
        return n
    }
    panik("term::lebar: argumen ke-1 harus teks, dapat `" + typeof(s) + "`")
}

pub fn term_lebar_tiap<V>(s: V) -> []int {
    if typeof(s) == "string" {
        let t: string = s
        var hasil: []int = []
        for _, c in str::chars(t) { hasil = arr::push(hasil, lapis::os(29, "", "", c as int).0) }
        return hasil
    }
    panik("term::lebar_tiap: argumen ke-1 harus teks, dapat `" + typeof(s) + "`")
}

// ── `re::` tanpa jembatan: mesin Pike yang sama (`regex_inti`, salinannya di runtime) lewat `lapis::os(30, ..)`.
// Kalimat gagal dan bentuk hasil sama dengan `src/stdlib/regex.rs`.
pub struct Regex { pub pattern: string }

fn _re_pola<R>(r: R, nama: string) -> string {
    if typeof(r) == "string" { let p: string = r; return p }
    if typeof(r) == "struct:Regex" { let x: Regex = r; return x.pattern }
    if typeof(r) == "dict" {
        if dict::has(r, "pattern") {
            let p = r["pattern"]
            if typeof(p) == "string" { let t: string = p; return t }
        }
        panik(nama + "invalid Regex object")
    }
    panik("butuh Regex atau pola berupa string")
}

fn _re_salah(nama: string, tipe: string, bentuk: string) -> string {
    "argumen tidak cocok untuk `" + nama + "` — dapat (" + tipe + "), bentuk yang diterima: " + bentuk
}

fn _re_os(pola: string, s: string, pengganti: string, mode: int) -> (int, string) {
    let h = lapis::os(30, pola, s + pengganti, (str::byte_len(s) << 3) | mode)
    if h.0 < 0 { panik(h.1) }
    h
}

fn _re_angka(t: string) -> []int {
    var hasil: []int = []
    for _, x in str::split(t, " ") { if x != "" { hasil = arr::push(hasil, int(x)) } }
    hasil
}

fn _re_cocok(s: string, a: []int, k: int) -> dict {
    let m: string = s[a[k]:a[k + 1]]
    let d = {"end": a[k + 3], "match": m, "start": a[k + 2]}
    d
}

pub fn re_compile<P>(pola: P) -> Regex {
    if typeof(pola) == "string" {
        let p: string = pola
        let _ = _re_os(p, "", "", 2)
        return Regex { pattern: p }
    }
    panik(_re_salah("re::compile", typeof(pola), "re::compile(pattern: string)"))
}

pub fn re_test<R, S>(r: R, s: S) -> bool {
    if typeof(s) == "string" && (typeof(r) == "string" || typeof(r) == "struct:Regex" || typeof(r) == "dict") {
        let t: string = s
        return _re_os(_re_pola(r, "re::test: "), t, "", 0).0 > 0
    }
    panik(_re_salah("re::test", typeof(r) + ", " + typeof(s), "re::test(re, s)"))
}

pub fn re_match_str<P, S>(pola: P, s: S) -> bool {
    if typeof(pola) == "string" && typeof(s) == "string" {
        let p: string = pola
        let t: string = s
        return _re_os(p, t, "", 0).0 > 0
    }
    panik(_re_salah("re::match_str", typeof(pola) + ", " + typeof(s), "re::match_str(pattern, s)"))
}

pub fn re_find<R, S>(r: R, s: S) -> Option<dict> {
    if typeof(s) == "string" {
        let t: string = s
        let h = _re_os(_re_pola(r, ""), t, "", 0)
        if h.0 == 0 { return None }
        return Some(_re_cocok(t, _re_angka(h.1), 0))
    }
    panik(_re_salah("re::find", typeof(r) + ", " + typeof(s), "re::find(re, s)"))
}

pub fn re_find_all<R, S>(r: R, s: S) -> []dict {
    if typeof(s) == "string" {
        let t: string = s
        let a = _re_angka(_re_os(_re_pola(r, ""), t, "", 1).1)
        var hasil: []dict = []
        var k = 0
        while k < len(a) {
            hasil = arr::push(hasil, _re_cocok(t, a, k))
            k += 4
        }
        return hasil
    }
    panik(_re_salah("re::find_all", typeof(r) + ", " + typeof(s), "re::find_all(re, s)"))
}

fn _re_ganti<R, S, G>(r: R, s: S, pengganti: G, mode: int, nama: string) -> string {
    if typeof(s) == "string" && typeof(pengganti) == "string" {
        let t: string = s
        let g: string = pengganti
        return _re_os(_re_pola(r, ""), t, g, mode).1
    }
    panik(_re_salah(nama, typeof(r) + ", " + typeof(s) + ", " + typeof(pengganti), nama + "(re, s, replacement)"))
}

pub fn re_replace<R, S, G>(r: R, s: S, pengganti: G) -> string { _re_ganti(r, s, pengganti, 3, "re::replace") }

pub fn re_replace_all<R, S, G>(r: R, s: S, pengganti: G) -> string { _re_ganti(r, s, pengganti, 4, "re::replace_all") }

pub fn re_split<R, S>(r: R, s: S) -> []string {
    if typeof(s) == "string" {
        let t: string = s
        let a = _re_angka(_re_os(_re_pola(r, ""), t, "", 5).1)
        var hasil: []string = []
        var k = 0
        while k < len(a) {
            hasil = arr::push(hasil, t[a[k]:a[k + 1]])
            k += 2
        }
        return hasil
    }
    panik(_re_salah("re::split", typeof(r) + ", " + typeof(s), "re::split(re, s)"))
}

// ── `crypto::` sisanya tanpa jembatan: inti Rust yang sama (`kripto_inti`, salinannya di runtime) lewat
// `lapis::os(31, a, b, (n << 5) | op)`; byte menyeberang sebagai heksadesimal. Kalimat gagal = `src/dok/crypto.rs`.
fn _kripto(a: string, b1: string, b2: string, op: int) -> (int, string) {
    let r = lapis::os(31, a, b1 + b2, (str::byte_len(b1) << 5) | op)
    if r.0 < 0 { panik(r.1) }
    r
}

fn _kripto_hasil(a: string, b1: string, b2: string, op: int) -> Result<string, string> {
    let r = lapis::os(31, a, b1 + b2, (str::byte_len(b1) << 5) | op)
    if r.0 < 0 { return Err(r.1) }
    Ok(r.1)
}

fn _teks_arg<V>(v: V, nama: string) -> string {
    if typeof(v) == "string" { let t: string = v; return t }
    panik(nama + ": butuh string, dapat `" + typeof(v) + "`")
}

fn _byte_heks(h: string) -> []int {
    let b = str::bytes(h)
    var hasil: []int = []
    var i = 0
    while i + 1 < len(b) {
        hasil = arr::push(hasil, _digit16(b[i]) * 16 + _digit16(b[i + 1]))
        i += 2
    }
    hasil
}

fn _digit16(k: int) -> int { if k <= 57 { return k - 48 } k - 87 }

fn _acak_kunci(n: int, siapa: string) -> string {
    let r = lapis::os(28, "", "", n)
    if r.0 < 0 { panik(siapa + ": sumber acak yang aman tidak bisa dibaca: " + _galat_os(r.0) + " — angka dari jam bisa ditebak, jadi tidak dipakai untuk kripto") }
    r.1
}

pub fn crypto_hash<V>(isi: V) -> string { crypto_sha256(isi) }

pub fn crypto_sha512<V>(isi: V) -> string { _kripto(_heks_byte(_isi_byte(isi, "crypto::sha512")), "", "", 0).1 }

pub fn crypto_hmac_sha256<K, M>(kunci: K, pesan: M) -> string {
    let k = _heks_byte(_isi_byte(kunci, "crypto::hmac_sha256"))
    let m = _heks_byte(_isi_byte(pesan, "crypto::hmac_sha256"))
    _kripto(k, m, "", 1).1
}

pub fn crypto_compare_digest<A, B>(a: A, b: B) -> bool {
    let x = _heks_byte(_isi_byte(a, "crypto::compare_digest"))
    let y = _heks_byte(_isi_byte(b, "crypto::compare_digest"))
    _kripto(x, y, "", 2).0 == 1
}

pub fn crypto_base64url_encode<V>(isi: V) -> string {
    let b = _isi_byte(isi, "crypto::base64url_encode")
    var s = str::replace(str::replace(crypto_base64_encode(b), "+", "-"), "/", "_")
    while str::ends_with(s, "=") { s = s[0:len(s) - 1] }
    s
}

pub fn crypto_base64_decode<V>(t: V) -> Result<string, string> { _kripto_hasil(_teks_arg(t, "crypto::base64_decode"), "", "", 3) }
pub fn crypto_base64url_decode<V>(t: V) -> Result<string, string> { _kripto_hasil(_teks_arg(t, "crypto::base64url_decode"), "", "", 5) }
pub fn crypto_hex_decode<V>(t: V) -> Result<string, string> { _kripto_hasil(_teks_arg(t, "crypto::hex_decode"), "", "", 7) }

fn _kripto_byte(a: string, b1: string, b2: string, op: int) -> Result<[]int, string> {
    let r = _kripto_hasil(a, b1, b2, op)
    match r {
        Ok(h) => Ok(_byte_heks(h)),
        Err(e) => Err(e),
    }
}

pub fn crypto_base64_decode_bytes<V>(t: V) -> Result<[]int, string> { _kripto_byte(_teks_arg(t, "crypto::base64_decode_bytes"), "", "", 4) }
pub fn crypto_base64url_decode_bytes<V>(t: V) -> Result<[]int, string> { _kripto_byte(_teks_arg(t, "crypto::base64url_decode_bytes"), "", "", 6) }
pub fn crypto_hex_decode_bytes<V>(t: V) -> Result<[]int, string> { _kripto_byte(_teks_arg(t, "crypto::hex_decode_bytes"), "", "", 8) }

pub fn crypto_aes_gen_key() -> string { _acak_kunci(32, "crypto::aes_gen_key") }
pub fn crypto_aes_gen_iv() -> string { _acak_kunci(16, "crypto::aes_gen_iv") }

pub fn crypto_aes_encrypt<V, K, I>(isi: V, kunci: K, iv: I) -> Result<string, string> {
    let p = _heks_byte(_isi_byte(isi, "crypto::aes_encrypt"))
    let k = _teks_arg(kunci, "crypto::aes_encrypt")
    let v = _teks_arg(iv, "crypto::aes_encrypt")
    _kripto_hasil(p, k, v, 9)
}

pub fn crypto_aes_decrypt<C, K, I>(sandi: C, kunci: K, iv: I) -> Result<string, string> {
    let c = _teks_arg(sandi, "crypto::aes_decrypt")
    let k = _teks_arg(kunci, "crypto::aes_decrypt")
    let v = _teks_arg(iv, "crypto::aes_decrypt")
    _kripto_hasil(c, k, v, 10)
}

pub fn crypto_aes_decrypt_bytes<C, K, I>(sandi: C, kunci: K, iv: I) -> Result<[]int, string> {
    let c = _teks_arg(sandi, "crypto::aes_decrypt_bytes")
    let k = _teks_arg(kunci, "crypto::aes_decrypt_bytes")
    let v = _teks_arg(iv, "crypto::aes_decrypt_bytes")
    _kripto_byte(c, k, v, 11)
}

pub fn crypto_seal<V, K>(isi: V, kunci: K) -> Result<string, string> {
    let p = _heks_byte(_isi_byte(isi, "crypto::seal"))
    let k = _teks_arg(kunci, "crypto::seal")
    _kripto_hasil(p, k, _acak_kunci(16, "crypto::seal"), 12)
}

pub fn crypto_unseal<C, K>(kotak: C, kunci: K) -> Result<string, string> {
    let c = _teks_arg(kotak, "crypto::unseal")
    let k = _teks_arg(kunci, "crypto::unseal")
    _kripto_hasil(c, k, "", 13)
}

pub fn crypto_unseal_bytes<C, K>(kotak: C, kunci: K) -> Result<[]int, string> {
    let c = _teks_arg(kotak, "crypto::unseal_bytes")
    let k = _teks_arg(kunci, "crypto::unseal_bytes")
    _kripto_byte(c, k, "", 14)
}

pub fn crypto_random_int<A, B>(lo: A, hi: B) -> int {
    if typeof(lo) == "int" && typeof(hi) == "int" {
        let a: int = lo
        let b: int = hi
        if b < a { panik("crypto::random_int: max harus >= min") }
        return int(_kripto(str(a), str(b), "", 15).1)
    }
    panik("argumen tidak cocok untuk `crypto::random_int` — dapat (" + typeof(lo) + ", " + typeof(hi) + "), bentuk yang diterima: crypto::random_int(min, max)")
}
